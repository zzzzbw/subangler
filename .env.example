# 仅用于首次启动引导。一旦数据库中已存在对应配置，以数据库为准。
# 复制为 .env 并按需修改；.env 不要提交到 git。

# 首次管理员账号（首次启动创建，之后请到 Web 设置页改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login

# 数据库位置（容器内路径）
SUBANGLER_DB_PATH=/app/config/subangler.db

# 日志级别
SUBANGLER_LOG_LEVEL=INFO

# TZ / 权限（Compose 中传入）
TZ=Asia/Shanghai
PUID=1000
PGID=1000
